# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=mdq-ridetube-d: RideTube daemon (BMW MediaPlayer audio, ytdec video, ctl socket for the app)
RequiresMountsFor=/var/opt
After=local-fs.target

[Service]
# root: SOME/IP to the MediaPlayer.
User=root
ExecStartPre=-/bin/sh -c 'mkdir -p /var/opt/mdq-ridetube-d/cache /var/opt/mdq-ridetube-d/log /var/opt/mdq-ridetube-d/state && chmod 0755 /var/opt/mdq-ridetube-d && chmod 0711 /var/opt/mdq-ridetube-d/cache && chmod 0700 /var/opt/mdq-ridetube-d/state'
# Fork (2026-11-07): the playing video in RAM, not on flash: a tmpfs capped at 256 MB (it holds only what is written,
# about 60-90 MB while a video plays). A plain mount, not TemporaryFileSystem=, so the BMW MediaPlayer sees the audio
# file there too. Without it ytd.js takes /dev/shm, else the flash cache as before.
ExecStartPre=-/bin/sh -c 'mkdir -p /run/mdq-ridetube-media && { grep -q " /run/mdq-ridetube-media tmpfs " /proc/mounts || mount -t tmpfs -o size=256m,mode=0711,nosuid,nodev,noexec tmpfs /run/mdq-ridetube-media; }'
# frees the RAM when the service stops (busy: kept, the next start takes it as it is)
ExecStopPost=-/bin/sh -c 'umount /run/mdq-ridetube-media 2>/dev/null; rmdir /run/mdq-ridetube-media 2>/dev/null; true'
# youtube.com/tv answers with 11 kB of headers; Node 8.14+ refuses more than 8 kB (HPE_HEADER_OVERFLOW)
ExecStart=/usr/bin/node --max-http-header-size=65536 /var/opt/mdq-ridetube-d/current/ytd.js
# The app (group tm_oap_app) must traverse the dir; ctl.sock itself is 0660 root:tm_oap_app.
RuntimeDirectory=mdq-ridetube-d
RuntimeDirectoryMode=0755
# The daemon starts idle and stays active with no app and no SOME/IP yet
# (it retries those itself), so the deploy health check sees it active.
Restart=on-failure
# 3 s keeps clear of systemd's 5-starts-in-10-s limit.
RestartSec=3
# SIGTERM releases the audio connection, then exits (4 s cap in ytd.js).
TimeoutStopSec=5
# 1, not 0: with a pipe core_pattern the kernel still pipes a core at limit 0 and skips
# only at 1 (its recursion guard), so the crash handler never sees ytd.js or ytdec.
# mgu-deploy adds the same LimitCORE=1 drop-in to every tool unit.
LimitCORE=1

[Install]
WantedBy=multi-user.target
