{
  "id": "mgu-render-id7-touch",
  "kind": "tool",
  "version": "1.4.0",
  "title": "Full-width touch",
  "description": "Lets full-screen apps (RideTube, Moonride) use the screen's left edge: both renderers get the whole screen as their touch area, so a tap on the strip where the back arrow usually is reaches the app instead of closing it. Leave such an app with the BACK or MENU button. Other apps keep the back arrow. Removing it takes effect at the next start of the head unit.",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "files": [
    {
      "path": "touch-guard.sh",
      "mode": "0755",
      "from": "touch-guard.sh"
    },
    {
      "path": "renderd-touch.sh",
      "mode": "0755",
      "from": "renderd-touch.sh"
    },
    {
      "path": "apply.sh",
      "mode": "0755",
      "from": "apply.sh"
    },
    {
      "path": "deactivate.sh",
      "mode": "0755",
      "from": "deactivate.sh"
    }
  ],
  "units": [],
  "enable": [],
  "recmgr": [],
  "restart": [],
  "activate": [
    "apply.sh"
  ],
  "dropins": [
    {
      "unit": "mgu-render.service",
      "name": "mgu-render-id7-touch.conf",
      "from": "dropins/mgu-render.service.d/mgu-render-id7-touch.conf"
    },
    {
      "unit": "idrive7-renderd.service",
      "name": "mgu-render-id7-touch.conf",
      "from": "dropins/idrive7-renderd.service.d/mgu-render-id7-touch.conf"
    }
  ],
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "deactivate": [
    "deactivate.sh"
  ]
}
